<article class="card"><p class="eyebrow"><%= l concert.starts_at.to_date, format: :long %> · <%= concert.starts_at.strftime("%H:%M") %></p><% if concert.cancelled? %><p class="badge">ANNULÉ</p><% end %><h3><%= concert.title %></h3><p><%= link_to concert.group.name, group_path(concert.group) %> · <%= concert.venue_name %> · <%= concert.city %></p><% if concert.address.present? %><p class="help"><%= concert.address %></p><% end %><%= simple_format concert.description if concert.description.present? %><% if concert.ticket_url.present? && !concert.cancelled? %><%= link_to "Infos / billetterie", concert.ticket_url, rel: "noopener", class: "button secondary" %><% end %></article>
