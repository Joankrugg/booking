<h1>Versions — <%= @skill.name %></h1><div class="actions"><%= link_to "Ajouter une version", new_admin_skill_skill_release_path(@skill), class: "button" %><%= link_to "Tous les skills", admin_skills_path %></div><% @releases.each do |release| %><article class="card"><h2><%= release.version %></h2><%= simple_format release.changelog %><div class="actions"><%= link_to "Modifier", edit_admin_skill_skill_release_path(@skill, release) %><%= button_to "Supprimer", admin_skill_skill_release_path(@skill, release), method: :delete, class: "danger" %></div></article><% end %>
