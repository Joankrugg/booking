<%= render "shared/errors", object: @release %><%= form_with model: [:admin, @skill, @release], class: "form" do |f| %><div class="field"><%= f.label :version, "Version (ex. 1.0.0)" %><%= f.text_field :version, required: true %></div><div class="field"><%= f.label :changelog, "Nouveautés de cette version (publiques)" %><%= f.text_area :changelog %></div><div class="field"><%= f.label :instructions, "Contenu intégral de SKILL.md (privé)" %><%= f.text_area :instructions, required: true, class: "instructions" %></div><%= f.submit "Enregistrer la version" %><% end %>
