<h1>Administration des skills</h1><%= link_to "Créer un skill", new_admin_skill_path, class: "button" %><% @skills.each do |skill| %><article class="card"><h2><%= skill.name %></h2><p><%= skill.published? ? "Publié" : "Brouillon" %></p><div class="actions"><%= link_to "Versions", admin_skill_skill_releases_path(skill) %><%= link_to "Modifier", edit_admin_skill_path(skill) %><%= button_to "Supprimer", admin_skill_path(skill), method: :delete, class: "danger", data: { turbo_confirm: "Supprimer le skill et toutes ses versions ?" } %></div></article><% end %>
