<%= render "shared/errors", object: @skill %><%= form_with model: [:admin, @skill], class: "form" do |f| %><div class="field"><%= f.label :name, "Nom" %><%= f.text_field :name, required: true %></div><div class="field"><%= f.label :description, "Objectif, résultat attendu, prérequis et installation" %><%= f.text_area :description, required: true %></div><div class="field"><%= f.label :compatibility, "Environnement compatible testé" %><%= f.text_field :compatibility, required: true %></div><div class="field"><%= f.label :published do %><%= f.check_box :published %> Publier la présentation<% end %></div><%= f.submit "Enregistrer" %><% end %>
