<article class="card"><span class="badge"><%= availability.status_label %></span><h3><%= link_to availability.group.name, group_path(availability.group) %></h3><p><%= l availability.date %> · <%= availability.area_name %> · déplacement jusqu’à <%= availability.travel_radius_km %> km<% if availability.starts_at_time %> · <%= availability.starts_at_time.strftime("%H:%M") %>–<%= availability.ends_at_time.strftime("%H:%M") %><% end %></p><%= simple_format availability.public_note if availability.public_note.present? %><p class="help">Confirmé le <%= l availability.confirmed_at.to_date %></p><%= mail_to availability.group.contact_email, "Contacter le groupe", subject: "Concert #{l availability.date} — #{availability.area_name}", class: "button secondary" %></article>
