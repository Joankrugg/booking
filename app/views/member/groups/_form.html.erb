<%= render "shared/errors", object: @group %><%= form_with model: [:member, @group], class: "form" do |f| %><% { name: "Nom du groupe", genre: "Style", city: "Ville d’origine", member_count: "Nombre de membres", contact_email: "Email public de contact", contact_phone: "Téléphone public", instagram_url: "Instagram — URL HTTPS", youtube_url: "YouTube — URL HTTPS", tiktok_url: "TikTok — URL HTTPS (si pertinent)" }.each do |field, label| %><div class="field"><%= f.label field, label %><% if field == :member_count %><%= f.number_field field, min: 1 %><% elsif field == :contact_email %><%= f.email_field field, required: true %><% else %><%= f.text_field field, required: field == :name %><% end %></div><% end %><div class="field"><%= f.label :description, "Présentation / histoire" %><%= f.text_area :description %></div><div class="field"><%= f.label :published do %><%= f.check_box :published %> Publier la fiche<% end %></div><%= f.submit "Enregistrer" %><% end %>
