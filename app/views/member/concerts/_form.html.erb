<%= render "shared/errors", object: @concert %><%= form_with model: [:member, @group, @concert], class: "form" do |f| %>
<% { title: "Nom du concert", venue_name: "Salle / lieu", city: "Ville", address: "Adresse (facultatif)", ticket_url: "Lien billetterie HTTPS (facultatif)" }.each do |field, label| %><div class="field"><%= f.label field, label %><%= f.text_field field, required: [:title, :venue_name, :city].include?(field) %></div><% end %>
<div class="field"><%= f.label :starts_at, "Date et heure (heure de Paris)" %><%= f.datetime_local_field :starts_at, required: true %></div><div class="field"><%= f.label :description, "Informations pour le public" %><%= f.text_area :description %></div><div class="field"><%= f.label :published do %><%= f.check_box :published %> Publier dans l’agenda des concerts<% end %></div><div class="field"><%= f.label :cancelled do %><%= f.check_box :cancelled %> Concert annulé (reste affiché comme annulé)<% end %></div><%= f.submit "Enregistrer le concert" %><% end %>
