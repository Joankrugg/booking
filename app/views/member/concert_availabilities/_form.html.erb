<%= render "shared/errors", object: @availability %><%= form_with model: [:member, @group, @availability], class: "form" do |f| %><div class="field"><%= f.label :date, "Date" %><%= f.date_field :date, required: true %></div><div class="field"><%= f.label :status, "État" %><%= f.select :status, ConcertAvailability::STATUSES %></div><div class="field"><%= f.label :area_name, "Ville de départ / centre de la zone" %><%= f.text_field :area_name, required: true, placeholder: "Ex. Bordeaux" %></div><div class="field"><%= f.label :travel_radius_km, "Rayon de déplacement (km)" %><%= f.number_field :travel_radius_km, min: 0, max: 1000, required: true %></div><div class="field"><%= f.label :starts_at_time, "Début possible (facultatif)" %><%= f.time_field :starts_at_time %></div><div class="field"><%= f.label :ends_at_time, "Fin possible (facultatif, même journée)" %><%= f.time_field :ends_at_time %></div><div class="field"><%= f.label :public_note, "Précisions publiques" %><%= f.text_area :public_note %></div><p class="help">Sans horaires, la date entière est déclarée. Une seule plage horaire par jour et zone. Confirmez les conditions avec l’organisateur.</p><%= f.submit "Enregistrer et confirmer" %><% end %>
