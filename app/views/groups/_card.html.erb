<article class="card"><p class="eyebrow"><%= group.genre.presence || "Projet musical" %></p><h2><%= link_to group.name, group_path(group) %></h2><p><%= truncate(group.description.to_s, length: 200) %></p><p class="muted"><%= group.city %><% if group.member_count %> · <%= group.member_count %> membres<% end %></p><%= link_to "Voir le groupe", group_path(group), class: "button secondary" %></article>
