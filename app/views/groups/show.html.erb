<%= link_to "Tous les groupes", groups_path %><p class="eyebrow"><%= @group.genre %></p><h1><%= @group.name %></h1><p class="muted"><%= @group.city %> · <%= @group.member_count || "Effectif à compléter" %> membres</p><%= simple_format @group.description %><div class="actions"><%= mail_to @group.contact_email, "Contacter le groupe", subject: "Programmation — #{@group.name}", class: "button" %><% { "Instagram" => @group.instagram_url, "YouTube" => @group.youtube_url, "TikTok" => @group.tiktok_url }.each do |label, url| %><% if url.present? %><%= link_to label, url, rel: "noopener" %><% end %><% end %></div><% if @group.contact_phone.present? %><p>Téléphone : <%= @group.contact_phone %></p><% end %><h2>Dates et zones déclarées</h2><p class="help">Une disponibilité n’est pas une réservation. Confirmez les horaires, déplacements et conditions directement avec le groupe. Les dates non reconfirmées depuis 30 jours ne sont plus affichées.</p><% if @availabilities.empty? %><p class="empty">Aucune disponibilité récemment confirmée. Contactez le groupe.</p><% else %><%= render partial: "public_availabilities/result", collection: @availabilities, as: :availability %><% end %>

<h2>Prochains concerts</h2><% if @concerts.empty? %><p class="empty">Aucun concert annoncé.</p><% else %><%= render partial: "concerts/card", collection: @concerts, as: :concert %><% end %>
