<div class="login-box">
  <h2>Mon compte</h2>

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "form auth-form", method: :put, data: { controller: "profile" } }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>
<%= render "profile_fields", f: f %>

    <div class="field">
      <%= f.label :email %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email" %>
    </div>

    <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
      <div>Currently waiting confirmation for: <%= resource.unconfirmed_email %></div>
    <% end %>

    <div class="field">
      <%= f.label :password %> <i>(laisser vide pour conserver votre mot de passe)</i>
      <%= f.password_field :password, autocomplete: "new-password" %>
      <% if @minimum_password_length %>
        
        <em><%= @minimum_password_length %> caractères minimum</em>
      <% end %>
    </div>

    <div class="field">
      <%= f.label :password_confirmation %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password" %>
    </div>

    <div class="field">
      <%= f.label :current_password %> <i>(votre mot de passe actuel est nécessaire)</i>
      <%= f.password_field :current_password, autocomplete: "current-password" %>
    </div>

    <div class="actions">
      <%= f.submit "Enregistrer" %>
    </div>
  <% end %>

  <h3>Supprimer mon compte</h3>

  <div> <%= button_to "Supprimer mon compte", registration_path(resource_name), data: { confirm: "Supprimer votre compte et ses groupes ?", turbo_confirm: "Supprimer votre compte et ses groupes ?" }, method: :delete %></div>

  <%= link_to "Retour", :back %>
</div>
