<%= f.hidden_field :usage_choices_submitted, value: "1" %>
<fieldset class="profile-options"><legend>Que souhaitez-vous faire ? Plusieurs choix possibles.</legend>
<% { uses_groups: ["Représenter un ou plusieurs groupes", "Publier mes disponibilités et mes concerts — gratuit et immédiat."], uses_organizing: ["Programmer des concerts", "Trouver des groupes disponibles à booker — gratuit."], uses_concerts: ["Trouver où sortir", "Consulter les concerts — gratuit, accessible aussi sans compte."] }.each do |field, (label, hint)| %><label class="profile-choice"><%= f.check_box field, data: { action: "change->profile#change" } %><%= label %><small><%= hint %></small></label><% end %></fieldset>
<section data-profile-target="organizer"><h2>Votre activité d’organisateur</h2><div class="field"><%= f.label :organizer_type, "Votre activité" %><%= f.select :organizer_type, User::ORGANIZER_TYPES, { include_blank: "Choisir une activité" }, { data: { profile_target: "activity" } } %></div><div class="field"><%= f.label :organization_name, "Nom de la salle ou de votre structure (facultatif)" %><%= f.text_field :organization_name %></div><div class="field"><%= f.label :profile_details, "Précisions sur votre projet (facultatif)" %><%= f.text_area :profile_details %></div></section>
