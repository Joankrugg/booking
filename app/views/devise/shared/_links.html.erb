<p><%= link_to "Connexion", new_session_path(resource_name) unless controller_name == "sessions" %></p>
<p><%= link_to "Créer un compte", new_registration_path(resource_name) if devise_mapping.registerable? && controller_name != "registrations" %></p>
<p><%= link_to "Mot de passe oublié", new_password_path(resource_name) if devise_mapping.recoverable? && controller_name != "passwords" %></p>
