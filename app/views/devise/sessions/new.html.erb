<h1>Connexion</h1><p>Retrouvez vos groupes et vos outils.</p>
<%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
<%= f.label :email, "Adresse e-mail" %><%= f.email_field :email, autofocus: true, autocomplete: "email", required: true %>
<%= f.label :password, "Mot de passe" %><%= f.password_field :password, autocomplete: "current-password", required: true %>
<%= f.submit "Se connecter", class: "button" %><% end %><%= render "devise/shared/links" %>
