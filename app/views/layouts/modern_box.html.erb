<!doctype html><html lang="fr"><head><title><%= content_for?(:title) ? yield(:title) : "Modern Box — Projets, groupes et outils IA" %></title><meta name="viewport" content="width=device-width,initial-scale=1"><%= csrf_meta_tags %><%= csp_meta_tag %><%= stylesheet_link_tag "modern_box", "modern_box_v3", "data-turbo-track": "reload" %><%= javascript_importmap_tags %></head><body><a class="skip" href="#main">Aller au contenu</a><header class="shell topbar"><%= link_to "MODERN BOX", root_path, class: "brand" %><nav aria-label="Navigation principale"><%= link_to "Groupes", groups_path %><%= link_to "Booker un groupe", availabilities_path %><%= link_to "Où sortir ?", concerts_path %><%= link_to "Skills IA", skills_path %><% if user_signed_in? %><%= link_to "Mon espace", member_root_path %><% if current_user.admin? %><%= link_to "Administration", admin_root_path %><% end %><%= button_to "Déconnexion", destroy_user_session_path, method: :delete, class: "plain" %><% else %><%= link_to "Connexion", new_user_session_path %><%= link_to "Créer un compte", new_user_registration_path %><% end %></nav></header><main class="shell" id="main"><% flash.each do |kind, message| %><p class="flash <%= kind %>" role="status"><%= message %></p><% end %><%= yield %></main><footer class="shell footer"><span>Modern Box — De l’idée au projet. Du projet au public.</span><a href="mailto:modernboxrecords@gmail.com">modernboxrecords@gmail.com</a><span>07 60 95 09 56</span></footer></body></html>
